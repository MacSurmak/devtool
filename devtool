def find_closest_match(content: str, search_block: str) -> str | None:
    target_lines = [
        line.strip() for line in search_block.strip().splitlines() if line.strip()
    ]
    if not target_lines:
        return None

    content_lines = content.splitlines()
    content_lines_stripped = [l.strip() for l in content_lines]
    target_len = len(target_lines)

    if len(content_lines) <= target_len:
        ratio = difflib.SequenceMatcher(
            None, target_lines, content_lines_stripped
        ).ratio()
        return content if ratio >= 0.4 else None

    best_ratio = 0.0
    best_slice = None
    min_win = max(1, target_len - 3)
    max_win = min(len(content_lines), target_len + 4)

    for win in range(min_win, max_win + 1):
        for i in range(len(content_lines) - win + 1):
            chunk = content_lines_stripped[i : i + win]
            ratio = difflib.SequenceMatcher(None, target_lines, chunk).ratio()
            if ratio > best_ratio:
                best_ratio = ratio
                best_slice = (i, i + win)

    if best_ratio >= 0.45 and best_slice:
        return "\n".join(content_lines[best_slice[0] : best_slice[1]])
    return None


def exact_find_and_replace(
    content: str, search_block: str, replace_block: str
) -> tuple[str, bool, str]:
    if search_block not in content:
        return content, False, "Точный блок SEARCH не найден в файле."
    count = content.count(search_block)
    if count > 1:
        return (
            content,
            False,
            f"Точный блок встречается в файле {count} раз(а). Необходим более уникальный контекст.",
        )
    return content.replace(search_block, replace_block, 1), True, "100% совпадение"


def apply_patch(patch_path=None, force_push: bool = False):
    root, ai_dir, _, default_patch, _ = get_ai_paths()
    has_git = is_git_repo(root)

    if has_git:
        status_res = run_git(["status", "--porcelain"], cwd=root)
        if status_res.stdout.strip():
            print("\n⚠️  В репозитории есть ваши незакоммиченные файлы:\n")
            print(run_git(["status", "-s"], cwd=root).stdout)
            user_msg = input(
                "📝 Введите сообщение коммита для ваших правок (или Enter для отмены): "
            ).strip()
            if not user_msg:
                print(
                    "🛑 Применение отменено. Закоммитьте изменения (`git commit`) или спрячьте (`git stash`), затем повторите devtool apply."
                )
                return
            run_git(["add", "-A"], cwd=root)
            run_git(["commit", "-m", user_msg], cwd=root)
            print(f'📦 Ваши файлы сохранены в коммит: "{user_msg}"\n')

    target_file = Path(patch_path) if patch_path else default_patch
    if not target_file.exists():
        print(f"❌ Файл патча не найден: {target_file}")
        return

    patch_text = target_file.read_text(encoding="utf-8").replace("\r\n", "\n")

    first_block_idx = patch_text.find("<<<<<<<")
    if first_block_idx == -1:
        print("❌ В файле патча нет инструкций devtool.")
        return

    first_chunk = patch_text[first_block_idx:]
    commit_match = COMMIT_PATTERN.match(first_chunk)
    if not commit_match:
        print(
            "❌ Первым блоком ОБЯЗАТЕЛЬНО должен быть <<<<<<< COMMIT ... >>>>>>> COMMIT"
        )
        return

    commit_msg = commit_match.group(1).strip()
    if not commit_msg:
        print("❌ Описание коммита в блоке COMMIT не может быть пустым.")
        return

    deletes = DELETE_PATTERN.findall(patch_text)
    creates = CREATE_PATTERN.findall(patch_text)
    replaces = [
        (m.group(1).strip(), m.group(2), m.group(3))
        for m in REPLACE_PATTERN.finditer(patch_text)
    ]

    if not (creates or deletes or replaces):
        print("❌ В файле патча нет инструкций (DELETE, CREATE или SEARCH/REPLACE).")
        return

    print("\n🔍 Предварительная проверка патча...")
    print("─" * 60)

    valid_deletes, failed_deletes = [], []
    for f in deletes:
        target = resolve_path(f, root)
        if target.exists():
            valid_deletes.append(f)
            print(f"  ✅ DELETE:  {f.strip()}")
        else:
            failed_deletes.append((f, "Файл не существует"))
            print(f"  ❌ DELETE:  {f.strip()} (файл не найден)")

    valid_creates, failed_creates = [], []
    for f, content in creates:
        valid_creates.append((f, content))
        print(f"  ✅ CREATE:  {f.strip()}")

    file_sim_content = {}
    valid_replaces, failed_replaces = [], []

    for f, search_b, replace_b in replaces:
        target = resolve_path(f, root)
        if not target.exists():
            failed_replaces.append((f, search_b, replace_b, "Файл не существует", None))
            print(f"  ❌ REPLACE: {f} (файл не существует)")
            continue

        if f not in file_sim_content:
            file_sim_content[f] = target.read_text(encoding="utf-8")

        current_content = file_sim_content[f]
        new_content, ok, reason = exact_find_and_replace(
            current_content, search_b, replace_b
        )
        if ok:
            file_sim_content[f] = new_content
            valid_replaces.append((f, search_b, replace_b))
            print(f"  ✅ REPLACE: {f} (100% совпадение)")
        else:
            closest = find_closest_match(current_content, search_b)
            failed_replaces.append((f, search_b, replace_b, reason, closest))
            print(f"  ❌ REPLACE: {f} ({reason})")

    print("─" * 60)
    failed_ops = len(failed_deletes) + len(failed_creates) + len(failed_replaces)
    success_ops = (len(deletes) + len(creates) + len(replaces)) - failed_ops

    if failed_replaces:
        print("\n⚠️  Детали ошибок в блоках SEARCH:")
        for idx, (f, sb, rb, reason, closest) in enumerate(failed_replaces, 1):
            print(f"\n[{idx}] Файл: {f}\n    Причина: {reason}")
            if closest:
                print("    💡 Наиболее похожий найденный блок в текущем файле:")
                print("    " + "-" * 40)
                for line in closest.splitlines()[:15]:
                    print(f"    | {line}")
                if len(closest.splitlines()) > 15:
                    print("    | ... (обрезано)")
                print("    " + "-" * 40)

    if failed_ops > 0:
        if success_ops == 0:
            print("\n🛑 Все операции завершились ошибкой. Патч не может быть применен.")
            return
        confirm = (
            input(
                f"\n⚠️ Готово к применению: {success_ops}, с ошибками: {failed_ops}. Применить только совпавшие? (y/N): "
            )
            .strip()
            .lower()
        )
        if confirm != "y":
            print("🛑 Применение отменено.")
            return

    for f in valid_deletes:
        target = resolve_path(f, root)
        if target.exists():
            target.unlink()
            print(f"🗑️  Удален: {f.strip()}")

    for f, content in valid_creates:
        dest = resolve_path(f, root)
        dest.parent.mkdir(parents=True, exist_ok=True)
        if content and not content.endswith("\n"):
            content += "\n"
        dest.write_text(content, encoding="utf-8")
        print(f"📄 Создан: {f.strip()}")

    for f in set(f for f, _, _ in valid_replaces):
        dest = resolve_path(f, root)
        dest.write_text(file_sim_content[f], encoding="utf-8")
        print(f"✏️  Изменен: {f}")

    if failed_ops > 0:
        remaining_patch = [f"<<<<<<< COMMIT\n{commit_msg}\n>>>>>>> COMMIT\n"]
        for f, _ in failed_deletes:
            remaining_patch.append(f"<<<<<<< DELETE: {f}\n>>>>>>> DELETE\n")
        for f, content in failed_creates:
            remaining_patch.append(f"<<<<<<< CREATE: {f}\n{content}>>>>>>> CREATE\n")
        for f, sb, rb, _, _ in failed_replaces:
            remaining_patch.append(
                f"<<<<<<< SEARCH: {f}\n{sb}\n=======\n{rb}\n>>>>>>> REPLACE\n"
            )
        target_file.write_text("\n".join(remaining_patch), encoding="utf-8")
        print(f"\n📋 Непримененные блоки сохранены в: {target_file}")
    else:
        if not patch_path and default_patch.exists():
            default_patch.write_text(
                "# Вставьте ответ нейросети сюда и запустите: devtool apply\n",
                encoding="utf-8",
            )

    if has_git:
        run_git(["add", "-A"], cwd=root)
        staged = run_git(["diff", "--cached", "--name-only"], cwd=root).stdout.strip()
        if not staged:
            print("\nℹ️  Изменений для коммита нет.")
            return

        run_git(["commit", "-m", commit_msg], cwd=root)
        print(f'📦 Сделан коммит: "{commit_msg}"')

        if force_push:
            branch = get_current_branch(root)
            print(f"🚀 Отправка изменений в remote (ветка {branch})...")
            push_res = run_git(["push", "-u", "origin", branch], check=False, cwd=root)
            if push_res.returncode == 0:
                print("✅ Изменения успешно отправлены в remote!")
            else:
                print(
                    f"⚠️  Ошибка push: {push_res.stderr.strip() or push_res.stdout.strip()}"
                )
    else:
        print("✅ Все совпавшие файлы обновлены на диске (без Git).")


def git_rollback():
    root = get_project_root()
    if not is_git_repo(root):
        print("❌ Проект не является Git-репозиторием.")
        return

    branch = get_current_branch(root)
    try:
        last_commit = run_git(["log", "-1", "--pretty=%B"], cwd=root).stdout.strip()
        confirm = (
            input(f'⚠️  Откатить последний коммит "{last_commit}"? (y/N): ')
            .strip()
            .lower()
        )
        if confirm != "y":
            print("Откат отменен.")
            return

        is_pushed = False
        remotes = run_git(["remote"], check=False, cwd=root).stdout.split()
        if "origin" in remotes:
            check_remote = run_git(
                ["merge-base", "--is-ancestor", "HEAD", f"origin/{branch}"],
                check=False,
                cwd=root,
            )
            if check_remote.returncode == 0:
                is_pushed = True

        run_git(["reset", "--hard", "HEAD~1"], cwd=root)
        run_git(["clean", "-fd"], cwd=root)
        print(f'✨ Коммит "{last_commit}" удален.')

        if is_pushed:
            remote_confirm = (
                input(f"Откатить ветку '{branch}' и на remote (force-push)? (y/N): ")
                .strip()
                .lower()
            )
            if remote_confirm == "y":
                push_res = run_git(
                    ["push", "--force-with-lease", "origin", branch],
                    check=False,
                    cwd=root,
                )
                if push_res.returncode == 0:
                    print(f"🚀 Изменения успешно откачены на remote (ветка {branch}).")
                else:
                    print(f"⚠️  Ошибка force-push: {push_res.stderr.strip()}")
    except subprocess.CalledProcessError as e:
        print(f"❌ Ошибка Git: {e.stderr}")


def manage_branches(branch_name: str | None = None):
    root = get_project_root()
    if not is_git_repo(root):
        print("❌ Проект не является Git-репозиторием.")
        return

    if not branch_name:
        current = get_current_branch(root)
        branches = run_git(["branch", "--list"], cwd=root).stdout
        print(f"🌿 Текущая ветка: {current}\n{branches}")
        return

    res = run_git(["branch", "--list"], cwd=root).stdout.splitlines()
    existing_branches = [b.strip().lstrip("* ") for b in res]

    if branch_name in existing_branches:
        run_git(["switch", branch_name], cwd=root)
        print(f"🔀 Переключились на ветку: {branch_name}")
    else:
        run_git(["switch", "-c", branch_name], cwd=root)
        print(f"🌱 Создана новая ветка: {branch_name}")


def run_black(target: str):
    root = get_project_root()
    has_git = is_git_repo(root)

    if has_git:
        status_res = run_git(["status", "--porcelain"], cwd=root)
        if status_res.stdout.strip():
            print("⚠️  У вас есть незакоммиченные изменения!")
            print(
                "Сначала закоммитьте их, чтобы не смешивать автоформатирование с вашим кодом."
            )
            return

    print(f"🎨 Запуск Black для: {target}")
    try:
        res = subprocess.run(["black", target], cwd=root)
        if res.returncode != 0:
            print("❌ Ошибка при форматировании. Проверьте синтаксис файлов.")
            return
    except FileNotFoundError:
        print("❌ Утилита 'black' не найдена. Установите её: pip install black")
        return

    if has_git:
        status_res = run_git(["status", "--porcelain"], cwd=root)
        if not status_res.stdout.strip():
            print("ℹ️  Изменений нет (код уже отформатирован).")
            return

        msg = "style: apply Black code formatter"
        run_git(["add", "-A"], cwd=root)
        run_git(["commit", "-m", msg], cwd=root)
        print(f'📦 Сделан коммит: "{msg}"')


def init_project(init_git: bool = False, remote_url: str | None = None):
    root = Path.cwd()
    ai_dir = root / AI_DIR_NAME
    ai_dir.mkdir(exist_ok=True)

    print(f"🚀 Инициализация AI DevTool в: {root}")
    has_git = is_git_repo(root)
    setup_git = init_git or bool(remote_url)

    if setup_git and not has_git:
        try:
            run_git(["init", "-b", "main"], cwd=root)
        except subprocess.CalledProcessError:
            run_git(["init"], cwd=root)
            run_git(["branch", "-M", "main"], cwd=root)
        has_git = True

    if has_git:
        gitignore = root / ".gitignore"
        if not gitignore.exists():
            gitignore.write_text(DEFAULT_GITIGNORE_TEMPLATE, encoding="utf-8")
        else:
            content = gitignore.read_text(encoding="utf-8")
            if f"{AI_DIR_NAME}/" not in content and AI_DIR_NAME not in content:
                with open(gitignore, "a", encoding="utf-8") as f:
                    f.write(f"\n# AI DevTool workdir\n{AI_DIR_NAME}/\n")

    if remote_url and has_git:
        remotes = run_git(["remote"], check=False, cwd=root).stdout.split()
        if "origin" in remotes:
            run_git(["remote", "set-url", "origin", remote_url], cwd=root)
        else:
            run_git(["remote", "add", "origin", remote_url], cwd=root)

    config = load_config(ai_dir)
    config["use_git"] = has_git
    if remote_url:
        config["remote"] = remote_url
    save_config(ai_dir, config)

    patch_file = ai_dir / DEFAULT_PATCH_NAME
    if not patch_file.exists():
        patch_file.write_text(
            "# Вставьте ответ нейросети сюда и запустите: devtool apply\n",
            encoding="utf-8",
        )

    dumpignore_file = ai_dir / DUMPIGNORE_NAME
    if not dumpignore_file.exists():
        dumpignore_file.write_text(DEFAULT_DUMPIGNORE_TEMPLATE, encoding="utf-8")

    print("✨ Готово!")


