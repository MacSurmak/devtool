def extract_python_signatures(content: str) -> list[str]:
    try:
        tree = ast.parse(content)
    except Exception:
        return []

    sigs = []
    has_unparse = hasattr(ast, "unparse")

    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            async_p = "async " if isinstance(node, ast.AsyncFunctionDef) else ""
            args_str = ast.unparse(node.args) if has_unparse else "..."
            ret_str = (
                f" -> {ast.unparse(node.returns)}"
                if has_unparse and node.returns
                else ""
            )
            sigs.append(f"{async_p}def {node.name}({args_str}){ret_str}")

        elif isinstance(node, ast.ClassDef):
            bases_str = (
                f"({', '.join(ast.unparse(b) for b in node.bases)})"
                if has_unparse and node.bases
                else ""
            )
            sigs.append(f"class {node.name}{bases_str}:")
            for sub in node.body:
                if isinstance(sub, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    m_args = ast.unparse(sub.args) if has_unparse else "..."
                    m_ret = (
                        f" -> {ast.unparse(sub.returns)}"
                        if has_unparse and sub.returns
                        else ""
                    )
                    sigs.append(f"  def {sub.name}({m_args}){m_ret}")
                elif isinstance(sub, ast.Assign) and len(sub.targets) == 1:
                    t_name = getattr(sub.targets[0], "id", None)
                    call_name = getattr(getattr(sub.value, "func", None), "id", None)
                    if t_name and call_name in ("Column", "Field"):
                        sigs.append(f"  {t_name} = {call_name}(...)")
    return sigs


def extract_nextflow_signatures(content: str) -> list[str]:
    sigs = []
    for line in content.splitlines():
        line_s = line.strip()
        if line_s.startswith("process ") and "{" in line_s:
            name = line_s.split()[1].replace("{", "").strip()
            sigs.append(f"process {name}")
        elif line_s.startswith("workflow ") and "{" in line_s:
            name = line_s.split()[1].replace("{", "").strip()
            sigs.append(f"workflow {name}")
        elif line_s.startswith("include ") and "{" in line_s:
            parts = line_s.split("from")
            if len(parts) == 2:
                inc = (
                    parts[0]
                    .replace("include", "")
                    .replace("{", "")
                    .replace("}", "")
                    .strip()
                )
                from_path = parts[1].strip().strip("'\"")
                sigs.append(f"include: {inc} from '{from_path}'")
    return sigs[:25]


def extract_js_ts_signatures(content: str) -> list[str]:
    sigs = []
    pattern = re.compile(
        r"^\s*(export\s+)?(async\s+)?(function|class|interface|type)\s+([A-Za-z0-9_$]+)(.*?)(?:\{|=|$)",
        re.MULTILINE,
    )
    for m in pattern.finditer(content):
        _, async_kw, kind, name, rest = m.groups()
        async_str = "async " if async_kw else ""
        rest_clean = rest.strip()[:40]
        sigs.append(f"{async_str}{kind} {name}{rest_clean}")
    return sigs[:25]


def extract_go_rust_signatures(content: str) -> list[str]:
    sigs = []
    pattern = re.compile(
        r"^\s*(pub\s+)?(func|fn|type|struct|impl)\s+([A-Za-z0-9_]+)(.*?)(?:\{|$)",
        re.MULTILINE,
    )
    for m in pattern.finditer(content):
        pub, kind, name, rest = m.groups()
        pub_str = "pub " if pub else ""
        sigs.append(f"{pub_str}{kind} {name}{rest.strip()[:40]}")
    return sigs[:25]


def extract_config_signatures(path: Path, content: str) -> list[str]:
    ext = path.suffix.lower()
    if ext in (".yaml", ".yml"):
        keys = []
        for line in content.splitlines():
            if (
                line
                and not line.startswith(" ")
                and not line.startswith("#")
                and ":" in line
            ):
                k = line.split(":")[0].strip()
                if k:
                    keys.append(k)
        if keys:
            return [f"keys: [{', '.join(keys[:15])}]"]
    elif ext == ".json":
        try:
            data = json.loads(content)
            if isinstance(data, dict):
                return [f"keys: [{', '.join(list(data.keys())[:15])}]"]
        except Exception:
            pass
    elif ext == ".toml":
        sections = [
            l.strip()
            for l in content.splitlines()
            if l.strip().startswith("[") and l.strip().endswith("]")
        ]
        if sections:
            return sections[:15]
    return []


def extract_markdown_signatures(content: str) -> list[str]:
    headers = []
    for line in content.splitlines():
        if line.startswith("#"):
            headers.append(line.strip())
    return headers[:15]


def extract_bash_signatures(content: str) -> list[str]:
    sigs = []
    pattern = re.compile(
        r"^\s*(function\s+)?([A-Za-z0-9_-]+)\s*\(\)\s*\{", re.MULTILINE
    )
    for m in pattern.finditer(content):
        sigs.append(f"function {m.group(2)}()")
    return sigs[:20]


def extract_file_signatures(path: Path) -> list[str]:
    try:
        content = path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return []

    ext = path.suffix.lower()
    first_line = content.splitlines()[0].strip() if content else ""

    if ext in (".py", ".pyi") or (
        first_line.startswith("#!") and "python" in first_line
    ):
        return extract_python_signatures(content)
    elif ext in (".sh", ".bash", ".zsh") or (
        first_line.startswith("#!")
        and any(sh in first_line for sh in ("bash", "sh", "zsh"))
    ):
        return extract_bash_signatures(content)
    elif ext == ".nf":
        return extract_nextflow_signatures(content)
    elif ext in (".js", ".jsx", ".ts", ".tsx") or (
        first_line.startswith("#!") and "node" in first_line
    ):
        return extract_js_ts_signatures(content)
    elif ext in (".go", ".rs"):
        return extract_go_rust_signatures(content)
    elif ext in (".yaml", ".yml", ".json", ".toml"):
        return extract_config_signatures(path, content)
    elif ext in (".md", ".rst"):
        return extract_markdown_signatures(content)

    return []


