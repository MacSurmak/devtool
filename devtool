def main():
    parser = argparse.ArgumentParser(prog="devtool", description="AI DevTool - локальный инструмент интеграции с LLM")
    subparsers = parser.add_subparsers(dest="command")

    init_p = subparsers.add_parser("init", help="Инициализировать AI окружение в проекте")
    init_p.add_argument("--git", action="store_true", help="Создать локальный Git-репозиторий")
    init_p.add_argument("--remote", help="URL GitHub/GitLab репозитория (включает Git и авто-пуш)")

    dump_p = subparsers.add_parser("dump", help="Собрать контекст проекта для LLM")
    dump_p.add_argument("-o", "--output", help="Путь к файлу дампа")

    apply_p = subparsers.add_parser("apply", help="Применить патч от LLM")
    apply_p.add_argument("file", nargs="?", help="Путь к файлу патча (по умолчанию .ai/patch.txt)")
    apply_p.add_argument("--push", dest="push", action="store_true", default=None, help="Принудительно отправить коммит в remote")
    apply_p.add_argument("--no-push", dest="push", action="store_false", help="Не отправлять коммит в remote")

    subparsers.add_parser("rollback", help="Откатить последний [LLM] коммит")
    subparsers.add_parser("tree", help="Вывести дерево файлов проекта")

    args = parser.parse_args()

    if args.command == "init":
        init_project(init_git=args.git, remote_url=args.remote)
    elif args.command == "dump":
        dump_project(args.output)
    elif args.command == "apply":
        apply_patch(args.file, force_push=args.push)
    elif args.command == "rollback":
        git_rollback()
    elif args.command == "tree":
        print_tree()
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
