COMMIT_PATTERN = re.compile(r"^<{7}\s*COMMIT\s*\n(.*?)\n>{7}\s*COMMIT", re.DOTALL)
CREATE_PATTERN = re.compile(
    r"<{7}\s*CREATE:\s*([^\n\r]+?)\s*\n(.*?)>{7}\s*CREATE", re.DOTALL
)
DELETE_PATTERN = re.compile(
    r"<{7}\s*DELETE:\s*([^\n\r]+?)\s*\n>{7}\s*DELETE", re.DOTALL
)
REPLACE_PATTERN = re.compile(
    r"<{7}\s*SEARCH:\s*([^\n\r]+?)\s*\n"
    r"((?:(?!<{7}|={7}|>{7}).)*?)"
    r"\n={7}[ \t]*\n"
    r"((?:(?!<{7}|>{7}).)*?)"
    r"(?:\n|^)>{7}[ \t]*REPLACE",
    re.DOTALL | re.MULTILINE,
)


def run_git(args, check=True, cwd=None):
    res = subprocess.run(["git"] + args, capture_output=True, text=True, cwd=cwd)
    if check and res.returncode != 0:
        err = res.stderr.strip() or res.stdout.strip()
        print(f"\n❌ Git error (`git {' '.join(args)}`):\n{err}\n")
        raise subprocess.CalledProcessError(
            res.returncode, ["git"] + args, output=res.stdout, stderr=res.stderr
        )
    return res


def is_git_repo(root: Path) -> bool:
    res = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"],
        capture_output=True,
        text=True,
    )
    return res.returncode == 0


def get_current_branch(root: Path) -> str:
    res = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--abbrev-ref", "HEAD"],
        capture_output=True,
        text=True,
    )
    return res.stdout.strip() if res.returncode == 0 else "main"


def get_project_root() -> Path:
    try:
        res = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
        )
        if res.returncode == 0:
            return Path(res.stdout.strip())
    except Exception:
        pass
    return Path.cwd()


def get_ai_paths():
    root = get_project_root()
    ai_dir = root / AI_DIR_NAME
    return (
        root,
        ai_dir,
        ai_dir / DEFAULT_DUMP_NAME,
        ai_dir / DEFAULT_PATCH_NAME,
        ai_dir / DUMPIGNORE_NAME,
    )


def resolve_path(p_str: str, root: Path) -> Path:
    p = Path(p_str.strip()).expanduser()
    return p if p.is_absolute() else root / p


def load_config(ai_dir: Path) -> dict:
    cfg_file = ai_dir / CONFIG_NAME
    if cfg_file.exists():
        try:
            return json.loads(cfg_file.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def save_config(ai_dir: Path, cfg: dict):
    ai_dir.mkdir(parents=True, exist_ok=True)
    (ai_dir / CONFIG_NAME).write_text(
        json.dumps(cfg, indent=2, ensure_ascii=False), encoding="utf-8"
    )


