def dump_skeleton(root: Path, out_file: Path, rules: list[str]):
    tree_lines = build_skeleton_tree(root, root, rules=rules)
    header = (
        "================================================\n"
        f" SKELETON: {root.name}\n"
        "================================================\n\n"
        f"{root.name}/\n" + "\n".join(tree_lines) + "\n"
    )
    out_file.parent.mkdir(parents=True, exist_ok=True)
    out_file.write_text(header, encoding="utf-8")

    total_lines = len(tree_lines)
    est_tokens = int(len(header) / 4)
    print(f"✨ Скелет проекта собран: {out_file}")
    print(f"📊 Строк: {total_lines} | Примерный объем: ~{est_tokens:,} токенов")
    print("💡 Для вывода полного содержимого файлов используйте:")
    print("   devtool dump <path1> <path2> ...")


def dump_targeted(
    root: Path, out_file: Path, target_paths: list[str], rules: list[str]
):
    matched_files = set()

    def collect_dir(d_path: Path):
        for r, dirs, files in os.walk(d_path):
            rel_root = Path(r).relative_to(root)
            dirs[:] = [
                d
                for d in dirs
                if not should_ignore(
                    rel_root / d if str(rel_root) != "." else Path(d), True, rules
                )
            ]
            for file in files:
                fp = Path(r) / file
                rel = fp.relative_to(root)
                if not should_ignore(rel, False, rules) and is_text_file(fp):
                    matched_files.add(fp)

    for t_str in target_paths:
        if t_str == ".":
            collect_dir(root)
            continue

        target = resolve_path(t_str, root)
        if target.exists():
            if target.is_file():
                rel = target.relative_to(root)
                if not should_ignore(rel, False, rules) and is_text_file(target):
                    matched_files.add(target)
            elif target.is_dir():
                collect_dir(target)
        else:
            matched = list(root.glob(t_str))
            if not matched:
                print(f"⚠️  Путь не найден: {t_str}")
                continue
            for m in matched:
                if m.is_file():
                    rel = m.relative_to(root)
                    if not should_ignore(rel, False, rules) and is_text_file(m):
                        matched_files.add(m)
                elif m.is_dir():
                    collect_dir(m)

    if not matched_files:
        print("❌ Не найдено текстовых файлов по указанным путям.")
        return

    sorted_files = sorted(list(matched_files))
    out_lines = [
        "================================================\n"
        f" TARGETED DUMP: {len(sorted_files)} file(s)\n"
        "================================================\n\n"
        "```devtool\n"
        "<<<<<<< COMMIT\n"
        f"Unroll {len(sorted_files)} file(s)\n"
        ">>>>>>> COMMIT\n"
    ]

    for fp in sorted_files:
        rel = fp.relative_to(root)
        try:
            content = fp.read_text(encoding="utf-8", errors="replace")
            out_lines.append(f"\n<<<<<<< CREATE: {rel}\n{content}")
            if not content.endswith("\n"):
                out_lines.append("\n")
            out_lines.append(">>>>>>> CREATE\n")
        except Exception as e:
            print(f"⚠️  Ошибка чтения {fp}: {e}")

    out_lines.append("```")

    result_text = "".join(out_lines)
    out_file.parent.mkdir(parents=True, exist_ok=True)
    out_file.write_text(result_text, encoding="utf-8")

    est_tokens = int(len(result_text) / 4)
    print(f"✅ Точечный дамп готов: {out_file}")
    print(
        f"📦 Файлов: {len(sorted_files)} | Примерный объем: ~{est_tokens:,} токенов (без дерева)"
    )
    for f in sorted_files:
        print(f"   • {f.relative_to(root)}")


def dump_full_legacy(root: Path, out_file: Path, rules: list[str]):
    tree_lines = build_skeleton_tree(root, root, rules=rules)
    out_lines = [
        "================================================\n",
        f" СТРУКТУРА: {root.name}\n",
        "================================================\n\n",
        f"{root.name}/\n",
        "\n".join(tree_lines),
        "\n\n" + "=" * 50 + "\n\n",
        "<<<<<<< COMMIT\n",
        f"Restore project from dump: {root.name}\n",
        ">>>>>>> COMMIT\n\n",
    ]

    for r, dirs, files in os.walk(root):
        rel_root = Path(r).relative_to(root)
        dirs[:] = [
            d
            for d in dirs
            if not should_ignore(
                rel_root / d if str(rel_root) != "." else Path(d), True, rules
            )
        ]

        for file in files:
            fp = Path(r) / file
            rel = fp.relative_to(root)
            if should_ignore(rel, False, rules) or not is_text_file(fp):
                continue
            try:
                content = fp.read_text(encoding="utf-8", errors="replace")
                out_lines.append(f"<<<<<<< CREATE: {rel}\n{content}")
                if not content.endswith("\n"):
                    out_lines.append("\n")
                out_lines.append(">>>>>>> CREATE\n\n")
            except Exception as e:
                print(f"⚠️  Пропуск {fp}: {e}")

    out_file.parent.mkdir(parents=True, exist_ok=True)
    out_file.write_text("".join(out_lines), encoding="utf-8")
    print(f"✅ Полный дамп всего проекта готов: {out_file}")


def dump_project(output_path=None, targets=None, full_dump=False):
    root, ai_dir, default_dump, _, dumpignore_file = get_ai_paths()
    ai_dir.mkdir(exist_ok=True)
    out_file = Path(output_path) if output_path else default_dump
    rules = load_dumpignore_rules(dumpignore_file)

    if full_dump:
        dump_full_legacy(root, out_file, rules)
    elif targets:
        dump_targeted(root, out_file, targets, rules)
    else:
        dump_skeleton(root, out_file, rules)


