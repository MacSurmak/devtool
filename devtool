def apply_patch(patch_path=None, force_push: bool | None = None):
    root, ai_dir, _, default_patch, _ = get_ai_paths()
    config = load_config(ai_dir)
    has_git = is_git_repo(root)

    target_file = Path(patch_path) if patch_path else default_patch
    if not target_file.exists():
        print(f"❌ Файл патча не найден: {target_file}")
        return

    patch_text = target_file.read_text(encoding="utf-8").replace("\r\n", "\n")

    first_block_idx = patch_text.find("<<<<<<<")
    if first_block_idx == -1:
        print("❌ В файле патча нет инструкций devtool.")
        return

    first_chunk = patch_text[first_block_idx:]
    commit_match = COMMIT_PATTERN.match(first_chunk)
    if not commit_match:
        print("❌ Первым блоком ОБЯЗАТЕЛЬНО должен быть <<<<<<< COMMIT ... >>>>>>> COMMIT")
        return

    commit_msg = commit_match.group(1).strip()
    if not commit_msg:
        print("❌ Описание коммита в блоке COMMIT не может быть пустым.")
        return

    deletes = DELETE_PATTERN.findall(patch_text)
    creates = CREATE_PATTERN.findall(patch_text)

    replaces = []
    for m in REPLACE_PATTERN.finditer(patch_text):
        f = m.group(1).strip()
        search_b = m.group(2)
        replace_b = m.group(3)
        replaces.append((f, search_b, replace_b))

    if not (creates or deletes or replaces):
        print("❌ В файле патча нет инструкций (DELETE, CREATE или SEARCH/REPLACE).")
        return

    # ------------------ DRY RUN ПРОВЕРКА ВСЕХ ПАТЧЕЙ ------------------
    print("\n🔍 Предварительная проверка патча...")
    print("─" * 60)

    valid_deletes, failed_deletes = [], []
    for f in deletes:
        target = resolve_path(f, root)
        if target.exists():
            valid_deletes.append(f)
            print(f"  ✅ DELETE:  {f.strip()}")
        else:
            failed_deletes.append((f, "Файл не существует"))
            print(f"  ❌ DELETE:  {f.strip()} (файл не найден)")

    valid_creates, failed_creates = [], []
    for f, content in creates:
        valid_creates.append((f, content))
        print(f"  ✅ CREATE:  {f.strip()}")

    # Проверка SEARCH / REPLACE на копии данных файлов
    file_sim_content = {}
    valid_replaces, failed_replaces = [], []

    for f, search_b, replace_b in replaces:
        target = resolve_path(f, root)
        if not target.exists():
            failed_replaces.append((f, search_b, replace_b, "Файл не существует", None))
            print(f"  ❌ REPLACE: {f} (файл не существует)")
            continue

        if f not in file_sim_content:
            file_sim_content[f] = target.read_text(encoding="utf-8")

        current_content = file_sim_content[f]
        new_content, ok, reason = exact_find_and_replace(current_content, search_b, replace_b)
        if ok:
            file_sim_content[f] = new_content
            valid_replaces.append((f, search_b, replace_b))
            print(f"  ✅ REPLACE: {f} (100% совпадение)")
        else:
            closest = find_closest_match(current_content, search_b)
            failed_replaces.append((f, search_b, replace_b, reason, closest))
            print(f"  ❌ REPLACE: {f} ({reason})")

    print("─" * 60)

    total_ops = len(deletes) + len(creates) + len(replaces)
    failed_ops = len(failed_deletes) + len(failed_creates) + len(failed_replaces)
    success_ops = total_ops - failed_ops

    # Вывод подробностей по ошибкам и похожих блоков
    if failed_replaces:
        print("\n⚠️  Детали ошибок в блоках SEARCH:")
        for idx, (f, sb, rb, reason, closest) in enumerate(failed_replaces, 1):
            print(f"\n[{idx}] Файл: {f}\n    Причина: {reason}")
            if closest:
                print("    💡 Наиболее похожий найденный блок в текущем файле:")
                print("    " + "-" * 40)
                for line in closest.splitlines()[:15]:
                    print(f"    | {line}")
                if len(closest.splitlines()) > 15:
                    print("    | ... (обрезано)")
                print("    " + "-" * 40)

    if failed_ops > 0:
        if success_ops == 0:
            print("\n🛑 Все операции завершились ошибкой. Патч не может быть применен.")
            return

        print(f"\n⚠️  Готово к применению: {success_ops}, с ошибками: {failed_ops}.")
        confirm = input("Применить только совпавшие операции? Несовпавшие останутся в patch-файле (y/N): ").strip().lower()
        if confirm != "y":
            print("🛑 Применение отменено пользователем.")
            return

    # ------------------ ПРИМЕНЕНИЕ ИЗМЕНЕНИЙ ------------------
    created_checkpoint = False
    if has_git:
        res = run_git(["status", "--porcelain"], cwd=root)
        if res.stdout.strip():
            print("💾 Обнаружены ваши ручные правки. Сохраняю чекпоинт...")
            run_git(["add", "-A"], cwd=root)
            run_git(["commit", "-m", f"{CHECKPOINT_PREFIX} Uncommitted user edits"], cwd=root)
            created_checkpoint = True

    touched_files = set()

    for f in valid_deletes:
        target = resolve_path(f, root)
        if target.exists():
            target.unlink()
            print(f"🗑️  Удален: {f.strip()}")

    for f, content in valid_creates:
        dest = resolve_path(f, root)
        dest.parent.mkdir(parents=True, exist_ok=True)
        if content and not content.endswith("\n"):
            content += "\n"
        dest.write_text(content, encoding="utf-8")
        touched_files.add(dest)
        print(f"📄 Создан: {f.strip()}")

    # Записываем успешно измененные файлы
    files_to_write = set(f for f, _, _ in valid_replaces)
    for f in files_to_write:
        dest = resolve_path(f, root)
        dest.write_text(file_sim_content[f], encoding="utf-8")
        touched_files.add(dest)
        print(f"✏️  Изменен: {f}")

    # Перезаписываем patch-файл: оставляем ТОЛЬКО то, что не применилось
    if failed_ops > 0:
        remaining_patch = [f"<<<<<<< COMMIT\n{commit_msg}\n>>>>>>> COMMIT\n"]
        for f, _ in failed_deletes:
            remaining_patch.append(f"<<<<<<< DELETE: {f}\n>>>>>>> DELETE\n")
        for f, content in failed_creates:
            remaining_patch.append(f"<<<<<<< CREATE: {f}\n{content}>>>>>>> CREATE\n")
        for f, sb, rb, _, _ in failed_replaces:
            remaining_patch.append(f"<<<<<<< SEARCH: {f}\n{sb}\n=======\n{rb}\n>>>>>>> REPLACE\n")

        target_file.write_text("\n".join(remaining_patch), encoding="utf-8")
        print(f"\n📋 Непримененные блоки сохранены в: {target_file}")
    else:
        if not patch_path and default_patch.exists():
            default_patch.write_text("# Вставьте ответ нейросети сюда и запустите: devtool apply\n", encoding="utf-8")

    # ------------------ GIT COMMIT & REMOTE PUSH ------------------
    if has_git:
        run_git(["add", "-A"], cwd=root)
        staged = run_git(["diff", "--cached", "--name-only"], cwd=root).stdout.strip()
        if not staged:
            print("\nℹ️  Изменений для коммита нет.")
            return

        full_msg = f"[LLM] {commit_msg}"
        run_git(["commit", "-m", full_msg], cwd=root)
        print(f"📦 Сделан коммит: \"{full_msg}\"")

        should_push = force_push if force_push is not None else config.get("auto_push", False)
        if should_push:
            branch = get_current_branch(root)
            print(f"🚀 Отправка изменений в remote (ветка {branch})...")
            push_res = run_git(["push", "-u", "origin", branch], check=False, cwd=root)
            if push_res.returncode == 0:
                print("✅ Изменения успешно отправлены на GitHub/remote!")
            else:
                print(f"⚠️  Не удалось выполнить push: {push_res.stderr.strip() or push_res.stdout.strip()}")
    else:
        print("✅ Все совпавшие файлы обновлены на диске (без Git).")


