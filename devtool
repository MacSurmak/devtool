def is_text_file(p: Path) -> bool:
    if p.suffix.lower() in TEXT_EXTENSIONS or p.name.startswith("."):
        return True
    try:
        with open(p, "rb") as f:
            chunk = f.read(1024)
            return b"\x00" not in chunk
    except Exception:
        return False


def build_tree(dir_path: Path, root_path: Path, rules: list[str] | None = None, prefix: str = "") -> list:
    tree = []
    try:
        entries = sorted(list(dir_path.iterdir()), key=lambda x: (x.is_file(), x.name.lower()))
    except (PermissionError, OSError):
        return [prefix + "└── [Доступ запрещен]"]

    valid_entries = []
    for e in entries:
        rel = e.relative_to(root_path)
        if rules is not None and should_ignore(rel, e.is_dir(), rules):
            continue
        valid_entries.append(e)

    for idx, e in enumerate(valid_entries):
        is_last = idx == len(valid_entries) - 1
        connector = "└── " if is_last else "├── "
        if e.is_dir():
            tree.append(f"{prefix}{connector}{e.name}/")
            ext = "    " if is_last else "│   "
            tree.extend(build_tree(e, root_path, rules, prefix + ext))
        else:
            tree.append(f"{prefix}{connector}{e.name}")
    return tree


def print_tree():
    root = get_project_root()
    print(f"{root.name}/")
    lines = build_tree(root, root, rules=None)
    if lines:
        print("\n".join(lines))


def dump_project(output_path=None):
    root, ai_dir, default_dump, _, dumpignore_file = get_ai_paths()
    ai_dir.mkdir(exist_ok=True)
    out_file = Path(output_path) if output_path else default_dump

    rules = load_dumpignore_rules(dumpignore_file)

    with open(out_file, "w", encoding="utf-8") as out:
        out.write("================================================\n")
        out.write(f" СТРУКТУРА: {root.name}\n")
        out.write("================================================\n\n")
        out.write(f"{root.name}/\n")
        out.write("\n".join(build_tree(root, root, rules=rules)))
        out.write("\n\n" + "=" * 50 + "\n\n")

        out.write("<<<<<<< COMMIT\n")
        out.write(f"Restore project from dump: {root.name}\n")
        out.write(">>>>>>> COMMIT\n\n")

        for r, dirs, files in os.walk(root):
            rel_root = Path(r).relative_to(root)
            dirs[:] = [
                d for d in dirs
                if not should_ignore(rel_root / d if str(rel_root) != "." else Path(d), True, rules)
            ]

            for file in files:
                fp = Path(r) / file
                rel = fp.relative_to(root)
                if should_ignore(rel, False, rules):
                    continue
                if not is_text_file(fp):
                    continue
                try:
                    content = fp.read_text(encoding="utf-8", errors="replace")
                    out.write(f"<<<<<<< CREATE: {rel}\n{content}")
                    if not content.endswith("\n"):
                        out.write("\n")
                    out.write(">>>>>>> CREATE\n\n")
                except Exception as e:
                    print(f"⚠️  Пропуск {fp}: {e}")

    print(f"✅ Дамп готов: {out_file}")
    print(f"📋 Правила фильтрации взяты из: {AI_DIR_NAME}/{DUMPIGNORE_NAME}")


