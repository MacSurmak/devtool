def is_text_file(p: Path) -> bool:
    if p.suffix.lower() in TEXT_EXTENSIONS or p.name.startswith("."):
        return True
    try:
        with open(p, "rb") as f:
            chunk = f.read(1024)
            return b"\x00" not in chunk
    except Exception:
        return False


def build_skeleton_tree(
    dir_path: Path, root_path: Path, rules: list[str] | None = None, prefix: str = ""
) -> list[str]:
    tree = []
    try:
        entries = sorted(
            list(dir_path.iterdir()), key=lambda x: (x.is_file(), x.name.lower())
        )
    except (PermissionError, OSError):
        return [prefix + "└── [Доступ запрещен]"]

    valid_entries = []
    for e in entries:
        rel = e.relative_to(root_path)
        if rules is not None and should_ignore(rel, e.is_dir(), rules):
            continue
        valid_entries.append(e)

    for idx, e in enumerate(valid_entries):
        is_last = idx == len(valid_entries) - 1
        connector = "└── " if is_last else "├── "
        ext = "    " if is_last else "│   "

        if e.is_dir():
            tree.append(f"{prefix}{connector}{e.name}/")
            tree.extend(build_skeleton_tree(e, root_path, rules, prefix + ext))
        else:
            tree.append(f"{prefix}{connector}{e.name}")
            if is_text_file(e):
                sigs = extract_file_signatures(e)
                if sigs:
                    sig_prefix = prefix + ext
                    for s_idx, sig in enumerate(sigs):
                        s_last = s_idx == len(sigs) - 1
                        s_conn = "└── " if s_last else "├── "
                        tree.append(f"{sig_prefix}{s_conn}{sig}")
    return tree


def export_tree(
    target: str = ".", output_path: str | None = None, to_stdout: bool = False
):
    root, ai_dir, default_dump, _, dumpignore_file = get_ai_paths()
    rules = load_dumpignore_rules(dumpignore_file)

    target_dir = resolve_path(target, root)
    if not target_dir.exists():
        print(f"❌ Путь не найден: {target}")
        return

    tree_lines = build_skeleton_tree(target_dir, root, rules=rules)
    scope_name = (
        root.name
        if target_dir == root
        else f"{root.name}/{target_dir.relative_to(root)}"
    )

    tree_text = (
        "================================================\n"
        f" СТРУКТУРА: {scope_name}\n"
        "================================================\n\n"
        f"{scope_name}/\n" + "\n".join(tree_lines) + "\n"
    )

    if to_stdout:
        print(tree_text)
        return

    out_file = Path(output_path) if output_path else default_dump
    out_file.parent.mkdir(parents=True, exist_ok=True)
    out_file.write_text(tree_text, encoding="utf-8")

    total_lines = len(tree_lines)
    est_tokens = int(len(tree_text) / 4)
    print(f"✅ Дерево проекта сохранено в: {out_file}")
    print(f"📊 Строк: {total_lines} | Примерный объем: ~{est_tokens:,} токенов")


