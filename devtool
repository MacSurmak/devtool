def load_dumpignore_rules(dumpignore_path: Path) -> list[str]:
    if not dumpignore_path.exists():
        dumpignore_path.parent.mkdir(parents=True, exist_ok=True)
        dumpignore_path.write_text(DEFAULT_DUMPIGNORE_TEMPLATE, encoding="utf-8")

    rules = []
    for line in dumpignore_path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        rules.append(line)
    return rules


def should_ignore(rel_path: Path, is_dir: bool, rules: list[str]) -> bool:
    path_str = str(rel_path).replace("\\", "/")
    name = rel_path.name

    for rule in rules:
        rule = rule.replace("\\", "/")
        if rule.endswith("/"):
            clean_rule = rule.rstrip("/")
            if is_dir:
                if fnmatch.fnmatch(name, clean_rule) or fnmatch.fnmatch(path_str, clean_rule) or fnmatch.fnmatch(path_str, f"*/{clean_rule}"):
                    return True
            else:
                parts = rel_path.parts[:-1]
                if any(fnmatch.fnmatch(p, clean_rule) for p in parts):
                    return True
        else:
            if fnmatch.fnmatch(name, rule) or fnmatch.fnmatch(path_str, rule) or fnmatch.fnmatch(path_str, f"*/{rule}"):
                return True
    return False


# ============================================================================
#                       EXACT MATCH & SIMILARITY HELPER
# ============================================================================

def find_closest_match(content: str, search_block: str) -> str | None:
    """Ищет наиболее похожий фрагмент файла с помощью скользящего окна (для диагностики)."""
    target_lines = [line.strip() for line in search_block.strip().splitlines() if line.strip()]
    if not target_lines:
        return None

    content_lines = content.splitlines()
    content_lines_stripped = [l.strip() for l in content_lines]
    target_len = len(target_lines)

    if len(content_lines) <= target_len:
        ratio = difflib.SequenceMatcher(None, target_lines, content_lines_stripped).ratio()
        return content if ratio >= 0.4 else None

    best_ratio = 0.0
    best_slice = None

    min_win = max(1, target_len - 3)
    max_win = min(len(content_lines), target_len + 4)

    for win in range(min_win, max_win + 1):
        for i in range(len(content_lines) - win + 1):
            chunk = content_lines_stripped[i:i + win]
            ratio = difflib.SequenceMatcher(None, target_lines, chunk).ratio()
            if ratio > best_ratio:
                best_ratio = ratio
                best_slice = (i, i + win)

    if best_ratio >= 0.45 and best_slice:
        return "\n".join(content_lines[best_slice[0]:best_slice[1]])
    return None


def exact_find_and_replace(content: str, search_block: str, replace_block: str) -> tuple[str, bool, str]:
    if search_block not in content:
        return content, False, "Точный блок SEARCH не найден в файле."
    count = content.count(search_block)
    if count > 1:
        return content, False, f"Точный блок встречается в файле {count} раз(а). Необходим более уникальный контекст."
    return content.replace(search_block, replace_block, 1), True, "100% совпадение"


