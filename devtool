def main():
    parser = argparse.ArgumentParser(
        prog="devtool", description="AI DevTool - локальный инструмент интеграции с LLM"
    )
    subparsers = parser.add_subparsers(dest="command")

    init_p = subparsers.add_parser(
        "init", help="Инициализировать AI окружение в проекте"
    )
    init_p.add_argument(
        "--git", action="store_true", help="Создать локальный Git-репозиторий"
    )
    init_p.add_argument("--remote", help="URL GitHub/GitLab репозитория")

    dump_p = subparsers.add_parser("dump", help="Собрать контекст проекта для LLM")
    dump_p.add_argument(
        "targets",
        nargs="*",
        help="Конкретные файлы или папки для дампа. Если не указаны — строится компактное дерево-скелет всего проекта.",
    )
    dump_p.add_argument(
        "-o", "--output", help="Путь к файлу вывода (по умолчанию .ai/dump.txt)"
    )
    dump_p.add_argument(
        "--full",
        action="store_true",
        help="Сделать полный дамп всех файлов проекта целиком (легаси режим)",
    )

    apply_p = subparsers.add_parser("apply", help="Применить патч от LLM")
    apply_p.add_argument(
        "file", nargs="?", help="Путь к файлу патча (по умолчанию .ai/patch.txt)"
    )
    apply_p.add_argument(
        "--push",
        action="store_true",
        help="Принудительно отправить коммит в remote",
    )

    branch_p = subparsers.add_parser(
        "branch", help="Создать ветку или переключиться на нее"
    )
    branch_p.add_argument(
        "name", nargs="?", help="Имя ветки (без имени покажет список веток)"
    )

    black_p = subparsers.add_parser(
        "black", help="Отформатировать код через Black и закоммитить"
    )
    black_p.add_argument(
        "target",
        nargs="?",
        default=".",
        help="Файл или папка (по умолчанию весь проект '.')",
    )

    tree_p = subparsers.add_parser(
        "tree", help="Собрать дерево файлов со скелетом в файл дампа"
    )
    tree_p.add_argument(
        "target",
        nargs="?",
        default=".",
        help="Папка для дерева (по умолчанию весь проект '.')",
    )
    tree_p.add_argument(
        "-o", "--output", help="Путь к файлу вывода (по умолчанию .ai/dump.txt)"
    )
    tree_p.add_argument(
        "--stdout", action="store_true", help="Вывести дерево в консоль вместо файла"
    )

    subparsers.add_parser("rollback", help="Откатить последний коммит")

    args = parser.parse_args()

    if args.command == "init":
        init_project(init_git=args.git, remote_url=args.remote)
    elif args.command == "dump":
        dump_project(output_path=args.output, targets=args.targets, full_dump=args.full)
    elif args.command == "apply":
        apply_patch(args.file, force_push=args.push)
    elif args.command == "branch":
        manage_branches(args.name)
    elif args.command == "black":
        run_black(args.target)
    elif args.command == "rollback":
        git_rollback()
    elif args.command == "tree":
        export_tree(
            target=args.target, output_path=args.output, to_stdout=args.stdout
        )
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
